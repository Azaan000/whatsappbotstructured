SECRET_KEY=your-long-random-secret-key
DASHBOARD_SECRET=your-dashboard-token

VERIFY_TOKEN=your-whatsapp-verify-token
WHATSAPP_TOKEN=your-whatsapp-bearer-token
PHONE_NUMBER_ID=your-phone-number-id

OPENROUTER_API_KEY=your-openrouter-key
AI_MODEL=openrouter/free

ALLOWED_ORIGINS=*
FLASK_DEBUG=false

# Owner WhatsApp notification recipients (comma-separated if multiple, e.g. 03410265630, 03001234567)
OWNER_PHONE_NUMBERS=03410265630

# --- Railway-specific ---
DB_PATH=/data/database.db
MEDIA_FOLDER=/data/media_files
BACKUP_DIR=/data/backups
LOG_DIR=/data/logs
BACKUP_RETENTION_DAYS=14